# ---- Build & Dependency Outputs ----
target/
**/target/
build/
**/build/
dist/
**/dist/
node_modules/
**/node_modules/
.npm/

# ---- Local Databases & Data Stores ----
backend/data/
**/data/
*.db
*.mv.db
*.trace.db
*.lock.db
onedrive-token.json

# ---- Environment Variables & Secrets ----
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# ---- IDE & Editor Configs ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.user
.project
.classpath
.settings/

# ---- Logs & Temporary Files ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
**/scratch/
**/docs/*/Drafts/
**/docs/Drafts/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db